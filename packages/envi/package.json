{
  "name": "@kynnyhsap/envi",
  "version": "1.0.0",
  "license": "MIT",
  "bin": {
    "envi": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/core/fixtures"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@envi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@envi/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build.ts",
    "prepack": "bun ../../scripts/prepack.ts LICENSE README.md"
  },
  "dependencies": {
    "@effect/platform-node-shared": "catalog:"
  },
  "devDependencies": {
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.19.0"
  }
}
