{
  "name": "envi",
  "version": "0.0.0",
  "license": "MIT",
  "bin": {
    "envi": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/core/fixtures"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@envi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@envi/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "cp ../../LICENSE ../../README.md ."
  },
  "dependencies": {
    "@effect/platform-node": "catalog:"
  },
  "devDependencies": {
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.116"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
