{
  "name": "@kynnyhsap/envi",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kynnyhsap/envi.git",
    "directory": "packages/envi"
  },
  "bin": {
    "envi": "./dist/bin.js"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "src",
    "!src/**/*.test.ts",
    "!src/core/fixtures"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@envi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@envi/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build.ts && bun run prepack",
    "prepack": "bun ../../scripts/prepack.ts LICENSE README.md packages/docs/content=docs skills"
  },
  "dependencies": {
    "@effect/platform-node-shared": "catalog:"
  },
  "devDependencies": {
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "config": {
    "docsUrl": "https://raw.githubusercontent.com/kynnyhsap/envi/v{version}/packages/docs/content/"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.19.0"
  }
}
