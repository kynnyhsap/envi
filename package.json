{
  "name": "envi-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@1password/sdk": "0.5.0",
      "@effect/platform-node": "4.0.0-rc.117",
      "@effect/platform-node-shared": "4.0.0-rc.117",
      "@effect/vitest": "4.0.0-rc.117",
      "@types/node": "26.6.2",
      "effect": "^4.0.0-rc.117",
      "typescript": "7.0.2",
      "vitest": "5.0.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun --conditions=@envi/source packages/envi/src/bin.ts",
    "dev:node": "node --conditions=@envi/source packages/envi/src/bin.ts",
    "build": "bun run --filter '*' build",
    "rename": "bun scripts/rename.ts",
    "names:check": "bun scripts/rename.ts --check",
    "versions": "bun scripts/versions.ts",
    "versions:check": "bun scripts/versions.ts --check",
    "release": "bun scripts/release.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples/tsconfig.json",
    "check": "bun run --parallel fmt:check lint typecheck names:check versions:check",
    "test:unit": "vitest run --project unit",
    "test:e2e": "bun run build && vitest run --project e2e",
    "test:onepassword": "bun run build && node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --project onepassword --no-file-parallelism",
    "test:linux": "sh tests/linux/run.sh",
    "test:unit:bun": "bun --bun vitest run --project unit",
    "test": "bun run --parallel test:unit test:unit:bun test:e2e",
    "verify": "bun run --parallel check test",
    "fixture:onepassword": "bun packages/onepassword/scripts/fixture.ts"
  },
  "devDependencies": {
    "@1password/sdk": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/vitest": "catalog:",
    "@kynnyhsap/envi": "workspace:*",
    "@kynnyhsap/envi-1password": "workspace:*",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "poof": "3.1.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.2"
}
