{
  "name": "envi",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "envi": "./dist/envi.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun src/bin.ts",
    "dev:node": "node src/bin.ts",
    "build": "bun build src/bin.ts --target=node --outfile=dist/envi.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p design/tsconfig.json",
    "check": "bun fmt:check && bun lint && bun typecheck",
    "test:unit": "vitest run --project unit",
    "test:e2e": "bun run build && vitest run --project e2e",
    "test": "bun test:unit && bun test:e2e",
    "verify": "bun run --parallel check test"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.116",
    "effect": "4.0.0-rc.116"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.116",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "26.6.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.2"
}
